# Kopie als .env anlegen und Werte setzen. Die .env gehört NIE ins Git-Repository.

# Port, auf dem die App läuft
PORT=3000

# Geheimer Schlüssel (mind. 32 Zeichen), z. B. erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Achtung: Wird er später geändert, müssen Gastromatic-Secret und Postfach-Passwort neu eingetragen
# und die Mitarbeiter neu abgeglichen werden.
APP_SECRET=

# Schlüssel für die Freischaltung des Kantinen-Tablets (beliebige lange Zeichenfolge)
KIOSK_KEY=

# mock = Testdaten (Pins 1111, 2222, 3333 ok · 4444 inaktiv · 5555 nicht eingestempelt ·
#        6666 Gastromatic nicht erreichbar · 7777 ausgeschieden)
# live = echte Gastromatic-API (Client ID und Secret im Admin-Bereich unter Settings eintragen)
GASTROMATIC_MODE=mock

# Erster Admin-Zugang (wird nur angelegt, solange noch kein Admin existiert)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Auf true setzen, sobald die App über HTTPS läuft
COOKIE_SECURE=false

# Nur wenn ein Reverse Proxy (z. B. nginx) davor läuft: TRUST_PROXY=1
# TRUST_PROXY=1

# Optional
# TIMEZONE=Europe/Berlin
# DATA_DIR=./data
