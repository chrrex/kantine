{
  "name": "kantine",
  "version": "0.1.0",
  "private": true,
  "description": "Kantinen-App für Schloss & Gut Liebenberg: Mittagessen per Terminal-Pin erfassen, Gäste eintragen, monatliche Excel an HR.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrrex/kantine.git"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "nodemailer": "^10.1.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
